# Names and descriptions only. Copy to .env and fill in; never commit real values.

# --- Site ---------------------------------------------------------------------------------
# "staging" labels draft policies, allows demo seed data and is closed to search engines.
# "production" hides drafts and refuses demo seeds and the development payment sandbox.
SITE_STAGE="staging"
# Public base URL of this deployment (used in emails, share links, sitemap, payment callbacks).
NEXTAUTH_URL="http://localhost:4174"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# --- Database (PostgreSQL) ------------------------------------------------------------------
# Local development: `npm run db:dev` starts an embedded Postgres on this URL.
# Staging/production: a dedicated NBM database (do NOT reuse the Optimais Labs database).
DATABASE_URL="postgresql://nbm:nbm_local_dev@localhost:54329/nbm_dev"
DIRECT_URL="postgresql://nbm:nbm_local_dev@localhost:54329/nbm_dev"

# --- First administrator (used by `npm run seed`) ----------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-this-before-seeding"

# --- Email delivery ---------------------------------------------------------------------------
# Set either RESEND_API_KEY or the SMTP_* variables. With neither, emails stay queued in the
# EmailOutbox table (visible at /admin/email) and nothing is sent.
RESEND_API_KEY=""
EMAIL_FROM="Nigeria's Beautiful Minds <hello@example.org>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Inbox that receives Contact us submissions. Founder input: not yet confirmed.
CONTACT_TO_EMAIL=""

# --- Media storage ------------------------------------------------------------------------------
# A PRIVATE Cloudflare R2 bucket (S3-compatible) dedicated to NBM. Leave blank in local
# development to store uploads on disk under .localdata/uploads (never used in production).
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Live audio (Discussion rooms) -----------------------------------------------------------------
# LiveKit Cloud project. Server-side only: never expose LIVEKIT_API_SECRET to the browser.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# --- Payments -----------------------------------------------------------------------------------
# "none"       : contributions are disabled; the site shows support enquiries only.
# "devsandbox" : local test checkout that moves no money (refused when SITE_STAGE=production).
# "paystack"   : hosted Paystack checkout. Requires PAYSTACK_SECRET_KEY and founder sign-off.
PAYMENT_PROVIDER="none"
PAYMENT_CURRENCY="NGN"
PAYSTACK_SECRET_KEY=""
# Signing secret for the development sandbox webhooks only.
DEV_PAYMENT_WEBHOOK_SECRET=""

# --- Scheduled jobs --------------------------------------------------------------------------------
# Bearer secret for /api/jobs (email retries, abandoned-upload cleanup, audio room reconciliation).
JOBS_SECRET=""

# --- Scholarships & Funding search ----------------------------------------------------------------
# Web-search API key from https://app.tavily.com (server-side only; never exposed to the browser).
# Blank: a search answers "Search isn't available yet" and returns no results.
TAVILY_API_KEY=""
# Most provider calls allowed per day across the whole site (each new search uses 2; repeats are
# served from the cache for 12 hours). 30 a day stays inside Tavily's free 1,000 credits a month.
SCHOLARSHIP_SEARCH_DAILY_CALLS="30"
# Testing only, ignored when SITE_STAGE=production: point the search at tests/mock-search-provider.ts.
SCHOLARSHIP_SEARCH_ENDPOINT=""
